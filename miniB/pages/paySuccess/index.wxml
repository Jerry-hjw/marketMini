<!--pages/paySuccess/index.wxml-->
<view class="main">
  <image src="/img/bgImg.jpg" class="bg-img"></image>
  <view class="container">
    <view class="data-box flex-box-vertical" style="justify-content: flex-start; padding: 60rpx 40rpx; border-radius: 20rpx; margin-top: 20rpx;">
      <image src="/img/paySuccess.png" style="width: 200rpx; height: 200rpx;" />
      <text class="bold-font" style="margin: 50rpx; letter-spacing: 6rpx;">支付成功</text>
      <view style="font-size: 28rpx; color: #999; letter-spacing: 5rpx; width: 300rpx;">支付方式 : 微信支付</view>
      <view style="font-size: 28rpx; color: #999; margin-top: 20rpx; letter-spacing: 5rpx; width: 300rpx;">支付金额 : {{ paid_amount }}</view>
      <view style="margin: 70rpx auto;"></view>
      <view class="flex-box" style="letter-spacing: 8rpx; font-size: 35rpx; text-align: center;">
        <!-- <view style="width: 47%; padding: 25rpx; box-sizing: border-box; border: 1rpx solid #999; color: #999; border-radius: 50rpx;" data-url="/pages/bill/index" bind:tap="toPage">查看账单</view> -->
        <view style="width: 47%; padding: 25rpx; box-sizing: border-box; background: linear-gradient(to bottom, #baf340, #8ec31f); color: #fff; border-radius: 50rpx;" data-url="/pages/rental/index" bind:tap="toPage">返回首页</view>
      </view>
    </view>
  </view>
</view>