<!--pages/applyDetail/index.wxml-->
<view class="main">
  <image src="/img/bgImg.jpg" class="bg-img"></image>
  <view class="container">
    <view class="data-box">
      <view wx:if="{{ detail.apply_status }}" class="flex-box-space">
        <text class="label">申请状态</text>
        <view class="flex-box-end" style="width: 60%;">
          <image src="{{ detail.evaluate_status === 'Y' ? '/img/status_complete.png' : (detail.oa_merchant_maintain_id && detail.apply_status === 'approvepass' ? '/img/status_confirm.png' : statusImg[detail.apply_status]) }}" style="width: 35rpx; height: 35rpx; margin-right: 10rpx;" />
          <text class="value">{{ detail.evaluate_status === 'Y' ? '已验收完成' : (detail.oa_merchant_maintain_id && detail.apply_status === 'approvepass' ? '维修完工待确认' : applyStatus[detail.apply_status]) }}</text>
        </view>
      </view>
      <view wx:if="{{ type !== 'merchantMaintain' }}" class="flex-box-space">
        <text class="bold-font"><text class="price-font">*</text>选择类型</text>
        <picker mode="selector" value="{{ detail.type }}" range-key="key" range="{{ detailType }}" class="value" bindchange="setType">{{ detail.type || '选择' }}></picker>
      </view>
      <view class="bold-font">商户信息</view>
      <view wx:if="{{ detail.apply_code }}" class="flex-box-space">
        <text class="label">申请单号</text>
        <text class="value">{{ detail.apply_code }}</text>
      </view>
      <view class="flex-box-space">
        <text class="label">申请商户</text>
        <text class="value">{{ detail.customer_name }}</text>
      </view>
      <view class="flex-box-space">
        <text class="label">商铺号</text>
        <text class="value">{{ detail.unit_name }}</text>
      </view>
      <view class="flex-box-space">
        <text class="label"><text class="price-font">*</text>申请人</text>
        <input type="text" value="{{ detail.apply_user_name }}" style="text-align: right; font-size: 26rpx; color: #999;" placeholder="请输入申请人" data-prop="apply_user_name" bindinput="setValue" />
      </view>
      <view class="flex-box-space">
        <text class="label"><text class="price-font">*</text>联系电话</text>
        <input type="number" value="{{ detail.apply_user_phone }}" placeholder="请输入联系电话" style="text-align: right; font-size: 26rpx; color: #999;" data-prop="apply_user_phone" bindinput="setValue" />
      </view>
      <view wx:if="{{ type === 'merchantMaintain' }}" class="flex-box-space">
        <text class="label"><text class="price-font">*</text>申请维修日期</text>
        <picker mode="date" value="{{ detail.maintain_date }}" class="value" data-prop="maintain_date" bindchange="setValue">{{ detail.maintain_date || '选择' }}></picker>
      </view>
      <view wx:if="{{ type === 'merchantMaintain' }}" class="flex-box-space">
        <text class="label"><text class="price-font">*</text>申请维修时间</text>
        <picker mode="time" value="{{ detail.maintain_time }}" class="value" data-prop="maintain_time" bindchange="setValue">{{ detail.maintain_time || '选择' }}></picker>
      </view>
      <view wx:if="{{ type === 'merchantMaintain' }}">
        <view class="bold-font"><text class="price-font">*</text>报修内容</view>
        <textarea value="{{ detail.apply_content }}" placeholder="请输入报修内容" maxlength="500" class="textarea" data-prop="apply_content" bindinput="setValue" />
      </view>
      <view wx:if="{{ type !== 'merchantMaintain' }}" class="flex-box-space">
        <text class="label"><text class="price-font">*</text>开始日期</text>
        <picker mode="date" value="{{ detail.start_date }}" class="value" data-prop="start_date" bindchange="setValue">{{ detail.start_date || '选择' }}></picker>
      </view>
      <view wx:if="{{ type !== 'merchantMaintain' }}" class="flex-box-space">
        <text class="label"><text class="price-font">*</text>开始时间</text>
        <picker mode="time" value="{{ detail.start_time }}" class="value" data-prop="start_time" bindchange="setValue">{{ detail.start_time || '选择' }}></picker>
      </view>
      <view wx:if="{{ type !== 'merchantMaintain' }}" class="flex-box-space">
        <text class="label"><text class="price-font">*</text>结束日期</text>
        <picker mode="date" value="{{ detail.end_date }}" class="value" data-prop="end_date" bindchange="setValue">{{ detail.end_date || '选择' }}></picker>
      </view>
      <view wx:if="{{ type !== 'merchantMaintain' }}" class="flex-box-space">
        <text class="label"><text class="price-font">*</text>结束时间</text>
        <picker mode="time" value="{{ detail.end_time }}" class="value" data-prop="end_time" bindchange="setValue">{{ detail.end_time || '选择' }}></picker>
      </view>
      <view wx:if="{{ type !== 'merchantMaintain' }}">
        <view class="bold-font"><text class="price-font">*</text>申请原因</view>
        <textarea value="{{ detail.reason }}" placeholder="请输入申请原因" maxlength="500" class="textarea" data-prop="reason" bindinput="setValue" />
      </view>
    </view>
    <view class="data-box" style="margin-top: 20rpx;">
      <view wx:if="{{ type === 'merchantMaintain' && detail.maintain_record}}">
        <view class="bold-font">维修记录</view>
        <textarea value="{{ detail.maintain_record }}" placeholder="请输入维修记录" maxlength="500" class="textarea" data-prop="maintain_record" bindinput="setValue" />
      </view>
      <view wx:if="{{ type === 'merchantMaintain' && detail.maintain_result }}">
        <view class="bold-font">维修结果</view>
        <textarea value="{{ detail.maintain_result }}" placeholder="请输入维修结果" maxlength="500" class="textarea" data-prop="maintain_result" bindinput="setValue" />
      </view>
      <view wx:if="{{ type === 'merchantMaintain' && detail.material_detail && detail.material_detail.length > 0 }}">
        <view class="flex-box-space">
          <view class="bold-font">材料清单</view>
        </view>
        <view class="flex-box-space" style="font-size: 28rpx;">
          <view style="width: 50%;">耗费材料名称</view>
          <view style="width: 15%;">规格</view>
          <view style="width: 15%;">单位</view>
          <view style="width: 15%;">数量</view>
        </view>
        <view wx:for="{{ arrayDetail }}" wx:key="index" class="flex-box-space">
          <input type="text" value="{{ item.name }}" style="width: 50%; height: 65rpx; font-size: 26rpx; color: #999; border-bottom: 1rpx solid #999;" data-prop="name" data-index="{{ index }}" bindinput="setDetail" />
          <input type="text" value="{{ item.sku }}" style="width: 15%; height: 65rpx; font-size: 26rpx; color: #999; border-bottom: 1rpx solid #999;" data-prop="sku" data-index="{{ index }}" bindinput="setDetail" />
          <input type="text" value="{{ item.unit }}" style="width: 15%; height: 65rpx; font-size: 26rpx; color: #999; border-bottom: 1rpx solid #999;" data-prop="unit" data-index="{{ index }}" bindinput="setDetail" />
          <input type="text" value="{{ item.quantity }}" style="width: 15%; height: 65rpx; font-size: 26rpx; color: #999; border-bottom: 1rpx solid #999;" data-prop="quantity" data-index="{{ index }}" bindinput="setDetail" />
        </view>
      </view>
      <view wx:if="{{ type === 'merchantMaterialInout' }}">
        <view class="flex-box-space">
          <view class="bold-font">物品清单</view>
          <view wx:if="{{ detail.apply_status !== 'approving' && detail.apply_status !== 'approvepass' }}" style="width: 40rpx; height: 40rpx; line-height: 37rpx; text-align: center; border-radius: 50%; border: 1rpx solid #8ce31f; color: #8ce31f; font-size: 30rpx;" bind:tap="addDetail">+</view>
        </view>
        <view wx:for="{{ arrayDetail }}" wx:key="index" class="flex-box-space">
          <input type="text" value="{{ item.name }}" placeholder="物品名称" style="width: 80%; height: 65rpx; font-size: 26rpx; color: #999; border-bottom: 1rpx solid #999;" data-prop="name" data-index="{{ index }}" bindinput="setDetail" />
          <input type="text" value="{{ item.quantity }}" placeholder="数量规格" style="width: 16%; height: 65rpx; font-size: 26rpx; color: #999; border-bottom: 1rpx solid #999;" data-prop="quantity" data-index="{{ index }}" bindinput="setDetail" />
        </view>
      </view>
      <view wx:if="{{ type === 'merchantOvertime' }}">
        <view class="flex-box-space">
          <view class="bold-font">人员名单</view>
          <view wx:if="{{ detail.apply_status !== 'approving' && detail.apply_status !== 'approvepass' }}" style="width: 40rpx; height: 40rpx; line-height: 37rpx; text-align: center; border-radius: 50%; border: 1rpx solid #8ce31f; color: #8ce31f; font-size: 30rpx;" bind:tap="addDetail">+</view>
        </view>
        <view wx:for="{{ arrayDetail }}" wx:key="index" class="flex-box-space">
          <input type="text" value="{{ item.name }}" placeholder="姓名" style="width: 34%; height: 65rpx; font-size: 26rpx; color: #999; border-bottom: 1rpx solid #999;" data-prop="name" data-index="{{ index }}" bindinput="setDetail" />
          <input type="text" value="{{ item.quantity }}" placeholder="身份证号" style="width: 60%; height: 65rpx; font-size: 26rpx; color: #999; border-bottom: 1rpx solid #999;" data-prop="quantity" data-index="{{ index }}" bindinput="setDetail" />
        </view>
      </view>
      <view>
        <view class="flex-box-space">
          <view class="bold-font">上传附件</view>
          <view wx:if="{{ detail.apply_status !== 'approving' && detail.apply_status !== 'approvepass' && fileList.length < 5 }}" style="width: 40rpx; height: 40rpx; line-height: 37rpx; text-align: center; border-radius: 50%; border: 1rpx solid #8ce31f; color: #8ce31f; font-size: 30rpx;" data-prop="fileList" bind:tap="upload">+</view>
        </view>
        <view wx:for="{{ fileList }}" wx:key="index" class="flex-box-space img-item">
          <image src="{{ IMG_BASE_URL + item.url }}" style="width: 150rpx; height: 100rpx;" mode="aspectFill" bind:tap="openFile" data-type="{{ item.type }}" data-url="{{ item.url }}" />
          <!-- <view bind:tap="openFile" data-type="{{ item.type }}" data-url="{{ item.url }}" style="width: calc(100% - 90rpx); font-size: 26rpx; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">{{ item.name }}</view> -->
          <view wx:if="{{ detail.apply_status !== 'approving' && detail.apply_status !== 'approvepass' }}" style="width: 80rpx; height: 50rpx; background-color: #8ce31f; border-radius: 5rpx; line-height: 50rpx; text-align: center; color: #fff; font-size: 26rpx;" data-url="{{ item.url }}" data-prop="fileList" bind:tap="deleteFile">删除</view>
        </view>
      </view>
      <view wx:if="{{ type === 'merchantMaintain' && detail.apply_status === 'approvepass' }}">
        <view class="flex-box-space">
          <view class="bold-font">完工图片</view>
        </view>
        <view class="flex-box-start" style="flex-wrap: wrap;">
          <image wx:for="{{ imgList }}" wx:key="index" src="{{ IMG_BASE_URL + item.url }}" style="width: 150rpx; height: 100rpx; margin-right: 15rpx;" mode="aspectFill" bind:tap="openFile" data-type="{{ item.type }}" data-url="{{ item.url }}" />
        </view>
      </view>
      <view>
        <view class="bold-font flex-box-space">备注</view>
        <textarea value="{{ detail.remark }}" placeholder="请输入备注" maxlength="500" class="textarea" data-prop="remark" bindinput="setValue" />
      </view>
      <view wx:if="{{ type === 'merchantMaintain' && detail.apply_status === 'approvenopass' }}" class="flex-box-start" style="margin: 20rpx 0;">
        <view class="bold-font"><text class="price-font">*</text>不通过原因</view>
        <view style="margin-left: 30rpx; font-size: 28rpx; word-wrap: break-word;">{{ detail.refuse_reason }}</view>
      </view>
      <view wx:if="{{ type === 'merchantMaintain' && detail.apply_status === 'approvepass' }}">
        <view class="bold-font flex-box-space">评价</view>
        <textarea value="{{ detail.evaluate_result }}" placeholder="请输入评价" maxlength="500" class="textarea" data-prop="evaluate_result" bindinput="setValue" />
      </view>
    </view>
    <view class="{{ type === 'merchantMaintain' && detail.apply_status === 'approvepass' && detail.evaluate_status === 'N' ? 'flex-box' : 'flex-box-space' }}">
      <view wx:if="{{ detail.apply_status !== 'approving' && detail.apply_status !== 'approvepass' }}" style="width: 220rpx; height: 65rpx; margin: 50rpx 0; background: #8ce31f; border-radius: 50rpx; text-align: center; line-height: 65rpx; font-weight: bold;" bindtap="save">保 存</view>
      <view wx:if="{{ detail.apply_status !== 'approving' && detail.apply_status !== 'approvepass' }}" style="width: 220rpx; height: 65rpx; margin: 50rpx 0; background: #8ce31f; border-radius: 50rpx; text-align: center; line-height: 65rpx; font-weight: bold;" bindtap="submit">提交审核</view>
      <view wx:if="{{ (detail.oa_merchant_maintain_id || detail.oa_merchant_overtime_id || detail.oa_merchant_material_inout_id) && detail.apply_status !== 'approving' && detail.apply_status !== 'approvepass' }}" style="width: 220rpx; height: 65rpx; margin: 50rpx 0; background: #8ce31f; border-radius: 50rpx; text-align: center; line-height: 65rpx; font-weight: bold;" bindtap="deleteApply">删 除</view>
      <view wx:if="{{ type === 'merchantMaintain' && detail.apply_status === 'approvepass' && detail.evaluate_status === 'N' }}" style="width: 300rpx; height: 65rpx; margin: 50rpx 0; background: #8ce31f; border-radius: 50rpx; text-align: center; line-height: 65rpx; font-weight: bold;" bindtap="evaluate">确 认 验 收</view>
    </view>
  </view>
</view>