/**app.wxss**/
.main {
  width: 100%;
  height: 100%;
  min-height: 100vh;
  position: relative;
}
.container {
  width: 94%;
  height: 100%;
  margin: 0 auto;
  padding: 20rpx 0;
}
.data-box {
  width: 99%;
  padding: 20rpx 25rpx;
  margin: 0 auto;
  box-sizing: border-box;
  border-radius: 8rpx;
  background-color: #fff;
  box-shadow: 0 0 8rpx #afadad;
}
.bg-img {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  z-index: -999;
}
.bg-img-cover {
  position: absolute;
  width: 60%;
  height: auto;
  top: 0;
  left: 0;
  z-index: -998;
}
.flex-box-space {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-box {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.flex-box-start {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.flex-box-end {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.flex-box-vertical {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.bold-font {
  font-size: 30rpx;
  font-weight: bold;
  color: #000;
}
.function-container {
  width: 100%;
  border-radius: 8rpx 90rpx 8rpx 8rpx;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #fff;
  box-shadow: 0 0 8rpx #afadad;
  margin-top: 30rpx;
}
.label-font {
  font-size: 22rpx;
  color: #999;
}
.close-button {
  width: 50rpx;
  height: 50rpx;
  position: absolute;
  top: 75%;
  left: 50%;
  transform: translate(-50%, 0);
  z-index: 21;
}
.toast {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-height: 100vh;
  z-index: 19;
}
.toast-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 20;
}
.toast-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  /* background-color: #fff; */
  border-radius: 30rpx;
  padding: 30rpx;
  box-sizing: border-box;
  z-index: 21;
}
.absolute {
  position: absolute;
  width: 100%;
  height: auto;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}
.fixed {
  position: fixed;
  width: 100%;
  bottom: 0;
  left: 50%;
  transform: translate(-50%, 0);
  box-sizing: border-box;
  z-index: 10;
}
.word-nowrap {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.primary-button {
  background: linear-gradient(to bottom, #cafc85, #8ec31f);
  border-radius: 50rpx;
  color: #000;
  font-weight: bold;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  text-align: center;
}
.price-font {
  font-size: 30rpx;
  color: #ea2e15;
  font-weight: bold;
}
