/* components/menu/index.wxss */
.menu {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  display: flex;
  align-items: center;
}
.menu-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 22rpx;
  /* margin-top: 18rpx; */
  font-weight: bold;
  color: #999;
}
.menu-img {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 6rpx;
}
.active {
  color: #8ec31f;
}