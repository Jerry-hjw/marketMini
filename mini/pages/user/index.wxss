/* pages/user/index.wxss */
.logo {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx #afadad;
}

.toast {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-height: 100vh;
}
.toast-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3);
}
.toast-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  background-color: #fff;
  border-radius: 15rpx;
  padding: 30rpx;
  box-sizing: border-box;
}
.popupBtn{
  width: 100%;
  background: #8ec31f;
  font-size: 32rpx;
  font-weight: bold;
  line-height: 32rpx;
  padding: 20rpx 0;
  color: #fff;
}