/* pages/invoiceList/index.wxss */
.body{
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
}

.tab {
    width: 100%;
    height: 60rpx;
    display: flex;
    align-items: center;
    font-size: 30rpx;
    margin: 20rpx auto;
}
.tab-title {
    flex: 1;
    line-height: 60rpx;
    text-align: center;
    background: rgba(82, 193, 238, 0.15);
    border: 1rpx solid rgb(82, 193, 238);
}
.tab-title-active {
    flex: 1;
    line-height: 60rpx;
    text-align: center;
    background: rgb(82, 193, 238);
    border: 1rpx solid rgb(82, 193, 238);
    color: #fff;
}
.bill-list {
    width: 100%;
    max-height: calc(100vh - 115rpx);
    font-size: 26rpx;
}
.bill-list-item {
    width: 99.5%;
    display: flex;
    align-items: center;
    background: #fff;
    margin: 20rpx auto;
    padding: 20rpx;
    border-radius: 10rpx;
    box-sizing: border-box;
    box-shadow: 1rpx 2rpx 5rpx #cecccc;
}
.bill-list-item-code {
  line-height: 50rpx;
  margin-bottom: 10rpx;
}
.bill-list-item-date {
  line-height: 40rpx;
  font-size: 23rpx;
  color: gray;
}
.bill-list-item-money {
  flex: 1; 
  text-align: right; 
  line-height: 50rpx;
  margin-bottom: 10rpx; 
  color: #f57309;
  font-size: 30rpx;
  font-weight: bold;
  font-family: monospace;
}
.clear-fix {
    height: 0;
    clear: both;
}
.flex-box {
  display: flex;
  align-items: center;
  justify-content: center;
}
.header {
  display: flex;
  height: 84rpx;
}
.header-item {
  color: #000;
  width: 140rpx;
  line-height: 80rpx;
  text-align: center;
  border-bottom: 4rpx solid transparent;
}
.header-item-active {
  color: #8ec31f;
  width: 140rpx;
  border-bottom: 4rpx solid #8ec31f;
  font-weight: bold;
  line-height: 80rpx;
  text-align: center;
}
.money {
  color: #ff1725; 
  font-size: 40rpx; 
  font-weight: bold;
  font-family: monospace;
}
.input-view {
  background-color: #e4ffd4;
  border-radius: 15rpx;
  padding: 0 25rpx;
  height: 100rpx;
  box-sizing: border-box;
}

.rt{
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translate(0, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}
.content_tv {
  color: #b7b7b7;
  font-size: 26rpx;
  line-height: 45rpx;
}
.pr{
  min-width: 110rpx;
  width: 110rpx;
  text-align-last: justify;
  -webkit-text-align-last: justify;
  margin-right: 60rpx;
  color: #666;
}
.bigt2{
  font-size: 28rpx;
  line-height: 34rpx;
}
.red{
  color: #ea2e15;
}
.blue{
  color: #2b68e5;
}