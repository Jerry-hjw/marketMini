<!--pages/contractApprove/index.wxml-->
<wxs module="StrUtil">
	module.exports.includes = function (str1, str2) {
		return str1.indexOf(str2) !== -1
	}
</wxs>
<view class="main">
  <image src="/img/bgImg.jpg" class="bg-img"></image>
  <view class="container">
    <!-- <view style="position: relative; margin-bottom: 25rpx;">
      <image src="/img/search.png" style="position: absolute; left: 15rpx; top: 15rpx; width: 45rpx; height: 45rpx;" />
      <input type="text" style="width: 100%; height: 70rpx; padding: 10rpx 75rpx; box-sizing: border-box; box-shadow: 0 0 8rpx rgb(194, 193, 193); background-color: rgba(255, 255, 255, 0.2); border-radius: 40rpx;" />
    </view> -->
    <view class="flex-box-space" style="letter-spacing: 3rpx; text-align: center;">
      <view class="flex-box" style="font-size: 28rpx; font-weight: bold; flex: 1;">
        <view style="padding: 10rpx 0; border-bottom: {{ taskType === 1 ? '4rpx solid #8ec31f' : '4rpx solid transparent' }};" data-type="{{ 1 }}" bind:tap="setTask">待处理</view>
      </view>
      <view class="flex-box" style="font-size: 28rpx; font-weight: bold; flex: 1;">
        <view style="padding: 10rpx 0; border-bottom: {{ taskType === 2 ? '4rpx solid #8ec31f' : '4rpx solid transparent' }};" data-type="{{ 2 }}" bind:tap="setTask">已处理</view>
      </view>
      <!-- <picker mode="date" style="font-size: 28rpx; font-weight: bold; padding: 10rpx 0; border-bottom: 4rpx solid transparent;" data-prop="startDate" bindchange="setDate">{{ startDate || '时间起' }}</picker>
      <picker mode="date" style="font-size: 28rpx; font-weight: bold; padding: 10rpx 0; border-bottom: 4rpx solid transparent;" data-prop="endDate" bindchange="setDate">{{ endDate || '时间止' }}</picker> -->
    </view>
    <scroll-view style="margin-top: 25rpx; font-size: 26rpx; color: #aaa; max-height: 90vh; padding-top: 5rpx;" scroll-y bindscrolltolower="getDataList">
      <view wx:for="{{ dataList }}" wx:key="index" class="data-box" style="margin-bottom: 25rpx; line-height: 50rpx;" data-index="{{ index }}" bind:tap="toDetail">
        <view>
          <view class="flex-box-space" style="font-weight: bold; color: #000;">
            <text wx:if="{{ StrUtil.includes(item.type, 'contract') }}">合同编号:</text>
            <text wx:if="{{ StrUtil.includes(item.type, 'merchant') }}">申请单号:</text>
            <text wx:if="{{ StrUtil.includes(item.type, 'merchant') || StrUtil.includes(item.type, 'contract') }}">{{ item.code }}</text>
            <text wx:else>{{ item.name }}</text>
          </view>
          <view wx:if="{{ StrUtil.includes(item.type, 'merchant') || StrUtil.includes(item.type, 'contract') }}" class="flex-box-space">
            <text wx:if="{{ StrUtil.includes(item.type, 'contract') }}" style="color: #000;">合同名称:</text>
            <text wx:if="{{ StrUtil.includes(item.type, 'merchant') }}" style="color: #000;">申请名称:</text>
            <text style="max-width: calc(100% - 140rpx);">{{ item.name }}</text>
          </view>
          <view class="flex-box-space">
            <text style="color: #000;">提交时间:</text>
            <text>{{ item.apply_date }}</text>
          </view>
        </view>
        <view wx:if="{{ taskType === 1 }}" style="width: 100%; border-bottom: 1rpx solid #eaeaea; margin: 20rpx 0;"></view>
        <view wx:if="{{ taskType === 1 }}" class="flex-box-end">
          <view data-index="{{ index }}" class="approve-btn" catch:tap="toProcess">审核进度</view>
          <view data-index="{{ index }}" data-status="N" class="approve-btn" catch:tap="toDetail">审核驳回</view>
          <view data-index="{{ index }}" data-status="Y" class="approve-btn" catch:tap="toDetail">审核通过</view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>