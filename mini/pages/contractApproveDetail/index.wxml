<!--pages/contractApproveDetail/index.wxml-->
<wxs module="StrUtil">
	module.exports.includes = function (str1, str2) {
		return str1.indexOf(str2) !== -1
	}
</wxs>
<view class="main">
  <image src="/img/bgImg.jpg" class="bg-img"></image>
  <view wx:if="{{ StrUtil.includes(type, 'contract') }}" class="container">
    <view wx:if="{{ contractChange }}" class="data-box" style="font-size: 26rpx; margin-bottom: 25rpx;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">合同变更信息</view>
      <view class="flex-box-space">
        <text>合同变更月份</text>
        <text class="text">{{ contractChange.yearmonth }}</text>
      </view>
      <view class="flex-box-space">
        <text>合同变更原因</text>
        <text class="text">{{ contractChange.change_reason }}</text>
      </view>
    </view>
    <view wx:if="{{ contractTerminal }}" class="data-box" style="font-size: 26rpx; margin-bottom: 25rpx;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">合同解约信息</view>
      <view class="flex-box-space">
        <text>解约时间</text>
        <text class="text">{{ contractTerminal.terminal_date }}</text>
      </view>
      <view class="flex-box-space">
        <text>解约原因</text>
        <text class="text">{{ contractTerminal.terminal_reason }}</text>
      </view>
      <view wx:if="{{ contractTerminal.listAddTerminalCostdetail && contractTerminal.listAddTerminalCostdetail.length > 0 }}" class="bold-font">新增费用</view>
      <view wx:for="{{ contractTerminal.listAddTerminalCostdetail }}" wx:key="unique" wx:for-item="cost" style="padding: 20rpx;">
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>费用名称:</text>
            <text class="text">{{ cost.cost_name }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>应收金额:</text>
            <text class="text">{{ cost.terminal_amount }}</text>
          </view>
        </view>
        <view class="flex-box-start">
          <text>备注:</text>
          <text class="text">{{ cost.remark }}</text>
        </view>
      </view>
      <view wx:if="{{ contractTerminal.listRefundTerminalCostdetail && contractTerminal.listRefundTerminalCostdetail.length > 0 }}" class="bold-font">应退费用</view>
      <view wx:for="{{ contractTerminal.listRefundTerminalCostdetail }}" wx:key="unique" wx:for-item="cost" style="padding: 20rpx;">
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>费用名称:</text>
            <text class="text">{{ cost.cost_name }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>应退金额:</text>
            <text class="text">{{ cost.contract_amount }}</text>
          </view>
        </view>
        <view class="flex-box-start">
          <text>实退金额:</text>
          <text class="text">{{ cost.terminal_amount }}</text>
        </view>
      </view>
      <view wx:if="{{ contractTerminal.listDeleteTerminalCostdetail && contractTerminal.listDeleteTerminalCostdetail.length > 0 }}" class="bold-font">免除费用费用</view>
      <view wx:for="{{ contractTerminal.listDeleteTerminalCostdetail }}" wx:key="unique" wx:for-item="cost" style="padding: 20rpx;">
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>费用名称:</text>
            <text class="text">{{ cost.cost_name }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>缴费周期:</text>
            <text class="text">{{ cost.start_date + '~' + cost.end_date }}</text>
          </view>
        </view>
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>应缴金额:</text>
            <text class="text">{{ cost.contract_amount }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>免除金额:</text>
            <text class="text">{{ cost.terminal_amount }}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{ contractSettle }}" class="data-box" style="font-size: 26rpx; margin-bottom: 25rpx;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">合同结算信息</view>
      <view class="flex-box-space">
        <text>结算时间</text>
        <text class="text">{{ contractSettle.settle_date }}</text>
      </view>
      <view class="flex-box-space">
        <text>结算原因</text>
        <text class="text">{{ contractSettle.settle_remark }}</text>
      </view>
      <view wx:if="{{ contractSettle.listAddSettleCostdetail && contractSettle.listAddSettleCostdetail.length > 0 }}" class="bold-font">新增费用</view>
      <view wx:for="{{ contractSettle.listAddSettleCostdetail }}" wx:key="unique" wx:for-item="cost" style="padding: 20rpx;">
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>费用名称:</text>
            <text class="text">{{ cost.cost_name }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>应收金额:</text>
            <text class="text">{{ cost.terminal_amount }}</text>
          </view>
        </view>
        <view class="flex-box-start">
          <text>备注:</text>
          <text class="text">{{ cost.remark }}</text>
        </view>
      </view>
      <view wx:if="{{ contractSettle.listRefundSettleCostdetail && contractSettle.listRefundSettleCostdetail.length > 0 }}" class="bold-font">应退费用</view>
      <view wx:for="{{ contractSettle.listRefundSettleCostdetail }}" wx:key="unique" wx:for-item="cost" style="padding: 20rpx;">
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>费用名称:</text>
            <text class="text">{{ cost.cost_name }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>应退金额:</text>
            <text class="text">{{ cost.contract_amount }}</text>
          </view>
        </view>
        <view class="flex-box-start">
          <text>实退金额:</text>
          <text class="text">{{ cost.terminal_amount }}</text>
        </view>
      </view>
      <view wx:if="{{ contractSettle.listDeleteSettleCostdetail && contractSettle.listDeleteSettleCostdetail.length > 0 }}" class="bold-font">免除费用费用</view>
      <view wx:for="{{ contractSettle.listDeleteSettleCostdetail }}" wx:key="unique" wx:for-item="cost" style="padding: 20rpx;">
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>费用名称:</text>
            <text class="text">{{ cost.cost_name }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>缴费周期:</text>
            <text class="text">{{ cost.start_date + '~' + cost.end_date }}</text>
          </view>
        </view>
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>应缴金额:</text>
            <text class="text">{{ cost.contract_amount }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>免除金额:</text>
            <text class="text">{{ cost.terminal_amount }}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="data-box" style="font-size: 26rpx;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">合同基本信息</view>
      <view class="flex-box-space">
        <text>合同类型:</text>
        <text class="text">{{ unitType[contract.pr_unit_type_id] }}</text>
      </view>
      <view class="flex-box-space">
        <text>合同编号:</text>
        <text class="text">{{ contract.contract_number }}</text>
      </view>
      <view class="flex-box-space">
        <text>合同名称:</text>
        <text class="text">{{ contract.contract_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>客户姓名:</text>
        <text class="text">{{ contract.prCustomerBean.customer_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>联系电话:</text>
        <text class="text">{{ contract.prCustomerBean.contacts_phone }}</text>
      </view>
      <view wx:if="{{ contract.prCustomerBean.certificate_type }}" class="flex-box-space">
        <text>证件类型:</text>
        <text class="text">{{ certificateType[contract.prCustomerBean.certificate_type] }}</text>
      </view>
      <view wx:if="{{ contract.prCustomerBean.certificate_number }}" class="flex-box-space">
        <text>证件号码:</text>
        <text class="text">{{ contract.prCustomerBean.certificate_number }}</text>
      </view>
      <view class="flex-box-space">
        <text>签约日期:</text>
        <text class="text">{{ contract.signing_date }}</text>
      </view>
      <view class="flex-box-space">
        <text>合同起止日期:</text>
        <text class="text">{{ (contract.start_date || '') + ' ~ ' + (contract.end_date || '') }}</text>
      </view>
      <view wx:if="{{ contract.renovation_start_date }}" class="flex-box-space">
        <text>装修起止日期:</text>
        <text class="text">{{ contract.renovation_start_date + ' ~ ' + contract.renovation_end_date }}</text>
      </view>
      <view wx:if="{{ contract.free_start_date }}" class="flex-box-space">
        <text>免租起止日期:</text>
        <text class="text">{{ contract.free_start_date + ' ~ ' + contract.free_start_date }}</text>
      </view>
      <view class="flex-box-space">
        <text>交付日期:</text>
        <text class="text">{{ contract.due_date }}</text>
      </view>
      <view class="flex-box-space">
        <text>总租赁面积:</text>
        <text class="text">{{ contract.building_area }}㎡</text>
      </view>
      <view wx:if="{{ contract.brand_name }}" class="flex-box-space">
        <text>品牌名称:</text>
        <text class="text">{{ contract.brand_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>水费分摊:</text>
        <text class="text">{{ contract.waterfee_share === 'Y' ? '是' : '否' }}</text>
      </view>
      <view class="flex-box-space">
        <text>电费分摊:</text>
        <text class="text">{{ contract.amfee_share === 'Y' ? '是' : '否' }}</text>
      </view>
      <view wx:if="{{ contract.rental_model }}" class="flex-box-space">
        <text>收费模式:</text>
        <text class="text">{{ rentalModel[contract.rental_model] }}</text>
      </view>
      <view wx:if="{{ contract.lease_purpose }}" class="flex-box-space">
        <text>租赁用途:</text>
        <text class="text">{{ contract.lease_purpose }}</text>
      </view>
      <view wx:if="{{ contract.remark }}" class="flex-box-space">
        <text>备注:</text>
        <text class="text">{{ contract.remark }}</text>
      </view>
    </view>
    <view class="data-box" style="font-size: 26rpx; margin: 25rpx 0;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">合同费项信息</view>
      <view wx:if="{{ unitCostList && unitCostList.length > 0 }}" class="bold-font">周期类费用</view>
      <view wx:for="{{ unitCostList }}" wx:key="unique" wx:for-item="unitCost" style="padding: 20rpx 0;">
        <view>{{ unitCost.prUnitBean.realty_full_name }}</view>
        <view wx:for="{{ unitCost.prContractRelUnitRelCostBeanList }}" wx:key="unique" wx:for-item="cost" style="padding: 0 20rpx; margin: 20rpx 0; font-size: 24rpx;">
          <view class="flex-box-start">
            <view class="flex-box-start" style="flex: 1;">
              <text>费用名称:</text>
              <text class="text">{{ cost.prCostBean.cost_name }}</text>
            </view>
            <view class="flex-box-start" style="flex: 1;">
              <text>缴费周期:</text>
              <text class="text">{{ paymentCycle[cost.prCostBean.payment_cycle] }}</text>
            </view>
          </view>
          <view class="flex-box-start">
            <view class="flex-box-start" style="flex: 1;">
              <text>开始日期:</text>
              <text class="text">{{ cost.start_date }}</text>
            </view>
            <view class="flex-box-start" style="flex: 1;">
              <text>结束日期:</text>
              <text class="text">{{ cost.end_date }}</text>
            </view>
          </view>
          <view class="flex-box-start">
            <view class="flex-box-start" style="flex: 1;">
              <text>含税价格:</text>
              <text class="text">{{ cost.contract_price }}</text>
            </view>
            <view class="flex-box-start" style="flex: 1;">
              <text>费用税率:</text>
              <text class="text">{{ cost.tax_rate }}</text>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{ commissionCostList && commissionCostList.length > 0 }}" class="bold-font">提成费用</view>
      <view wx:for="{{ commissionCostList }}" wx:key="unique" wx:for-item="commission" style="padding: 0 20rpx; margin: 20rpx 0; font-size: 24rpx;">
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>缴费周期:</text>
            <text class="text">{{ commissionRule[commission.commission_rule] }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>费用税率:</text>
            <text class="text">{{ commission.tax_rate }}</text>
          </view>
        </view>
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>开始日期:</text>
            <text class="text">{{ commission.start_date }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>结束日期:</text>
            <text class="text">{{ commission.end_date }}</text>
          </view>
        </view>
        <view class="flex-box-start">
          <view class="flex-box-start" style="flex: 1;">
            <text>基础业绩:</text>
            <text class="text">{{ commission.sales_min }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>提成率(%):</text>
            <text class="text">{{ commission.commission_percentage }}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{ onceCostList && onceCostList.length > 0 }}" class="bold-font">一次性费用</view>
      <view wx:for="{{ onceCostList }}" wx:key="unique" wx:for-item="onceCost">
        <view class="flex-box-start" style="padding: 0 20rpx; margin: 20rpx 0; box-sizing: border-box; font-size: 24rpx;">
          <view class="flex-box-start" style="flex: 1;">
            <text>费用名称:</text>
            <text class="text">{{ onceCost.prCostBean.cost_name }}</text>
          </view>
          <view class="flex-box-start" style="flex: 1;">
            <text>含税价格:</text>
            <text class="text">{{ onceCost.contract_price }}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{ contractFileList.length > 0 }}" class="data-box" style="font-size: 26rpx; margin: 25rpx 0;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">合同附件</view>
      <view wx:for="{{ contractFileList }}" wx:key="unique" wx:for-item="file" data-url="{{ file.file_url }}" data-name="{{ file.file_name }}" bind:tap="openFile">
        <view class="flex-box-space">
          <view class="word-nowrap" style="max-width: calc(100% - 100rpx);">{{ file.file_name }}</view>
          <view style="width: 80rpx; height: 40rpx; line-height: 40rpx; text-align: center; background-color: #8ec31f; color: #fff; border-radius: 8rpx; font-size: 24rpx;">预览</view>
        </view>
      </view>
    </view>
    <view wx:if="{{ contract.contract_file_name }}" class="data-box" style="font-size: 26rpx; margin: 25rpx 0;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">已签合同</view>
      <view class="flex-box-space" data-url="{{ contract.contract_file_url }}" data-name="{{ contract.contract_file_name }}" bind:tap="openFile">
        <view class="word-nowrap" style="max-width: calc(100% - 100rpx);">{{ contract.contract_file_name }}</view>
        <view style="width: 80rpx; height: 40rpx; line-height: 40rpx; text-align: center; background-color: #8ec31f; color: #fff; border-radius: 8rpx; font-size: 24rpx;">预览</view>
      </view>
    </view>
  </view>
  <view wx:if="{{ StrUtil.includes(type, 'overtime') }}" class="container">
    <view class="data-box" style="font-size: 26rpx;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">非营业作业基本信息</view>
      <view class="flex-box-space">
        <text>类型:</text>
        <text class="text">{{ merchantType[merchantOvertime.overtime_type] }}</text>
      </view>
      <view class="flex-box-space">
        <text>申请单号:</text>
        <text class="text">{{ merchantOvertime.apply_code }}</text>
      </view>
      <view class="flex-box-space">
        <text>申请商户:</text>
        <text class="text">{{ merchantOvertime.customer_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>铺位号:</text>
        <text class="text">{{ merchantOvertime.unit_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>申请人:</text>
        <text class="text">{{ merchantOvertime.apply_user_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>联系方式:</text>
        <text class="text">{{ merchantOvertime.apply_user_phone }}</text>
      </view>
      <view wx:if="{{ merchantOvertime.overtime_reason }}" class="flex-box-space">
        <text>申请原因:</text>
        <text class="text">{{ merchantOvertime.overtime_reason }}</text>
      </view>
      <view class="flex-box-space">
        <text>申请时间:</text>
        <text class="text">{{ merchantOvertime.apply_date }}</text>
      </view>
      <view class="flex-box-space">
        <text>开始时间:</text>
        <text class="text">{{ merchantOvertime.overtime_start || '' }}</text>
      </view>
      <view class="flex-box-space">
        <text>结束时间:</text>
        <text class="text">{{ merchantOvertime.overtime_end || '' }}</text>
      </view>
      <view wx:if="{{ merchantOvertime.overtimeWorkers }}" style="padding: 20rpx 0; color: #aaa;">
        <view style="margin-bottom: 15rpx; color: #000;">人员名单:</view>
        <view class="flex-box-start">
          <text style="flex: 1; margin-right: 15rpx;">姓名</text>
          <text style="flex: 1;">身份证号</text>
        </view>
        <view wx:for="{{ merchantOvertime.overtimeWorkers }}" wx:key="unique" wx:for-item="worker" class="flex-box-space">
          <view style="flex: 1; margin-right: 15rpx;">{{ worker.name }}</view>
          <view style="flex: 1;">{{ worker.quantity }}</view>
        </view>
      </view>
      <view wx:if="{{ merchantOvertime.remark }}" class="flex-box-space">
        <text>备注:</text>
        <text class="text">{{ merchantOvertime.remark }}</text>
      </view>
    </view>
    <view wx:if="{{ contractFileList.length > 0 }}" class="data-box" style="font-size: 26rpx; margin: 25rpx 0;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">非营业作业附件</view>
      <view wx:for="{{ contractFileList }}" wx:key="unique" wx:for-item="file" data-url="{{ file.file_url }}" data-name="{{ file.file_name }}" bind:tap="openFile">
        <view class="flex-box-space">
          <view class="word-nowrap" style="max-width: calc(100% - 100rpx);">{{ file.file_name }}</view>
          <view style="width: 80rpx; height: 40rpx; line-height: 40rpx; text-align: center; background-color: #8ec31f; color: #fff; border-radius: 8rpx; font-size: 24rpx;">预览</view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{ StrUtil.includes(type, 'materialinout') }}" class="container">
    <view class="data-box" style="font-size: 26rpx;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">物品放行基本信息</view>
      <view class="flex-box-space">
        <text>类型:</text>
        <text class="text">{{ merchantType[merchantMaterialInout.material_inout_type] }}</text>
      </view>
      <view class="flex-box-space">
        <text>申请单号:</text>
        <text class="text">{{ merchantMaterialInout.apply_code }}</text>
      </view>
      <view class="flex-box-space">
        <text>申请商户:</text>
        <text class="text">{{ merchantMaterialInout.customer_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>铺位号:</text>
        <text class="text">{{ merchantMaterialInout.unit_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>申请人:</text>
        <text class="text">{{ merchantMaterialInout.apply_user_name }}</text>
      </view>
      <view class="flex-box-space">
        <text>联系方式:</text>
        <text class="text">{{ merchantMaterialInout.apply_user_phone }}</text>
      </view>
      <view wx:if="{{ merchantMaterialInout.material_inout_reason }}" class="flex-box-space">
        <text>申请原因:</text>
        <text class="text">{{ merchantMaterialInout.material_inout_reason }}</text>
      </view>
      <view class="flex-box-space">
        <text>申请时间:</text>
        <text class="text">{{ merchantMaterialInout.apply_date }}</text>
      </view>
      <view class="flex-box-space">
        <text>开始时间:</text>
        <text class="text">{{ merchantMaterialInout.material_inout_start || '' }}</text>
      </view>
      <view class="flex-box-space">
        <text>结束时间:</text>
        <text class="text">{{ merchantMaterialInout.material_inout_end || '' }}</text>
      </view>
      <view wx:if="{{ merchantMaterialInout.materialDetail }}" style="padding: 20rpx 0; color: #aaa;">
        <view style="margin-bottom: 15rpx; color: #000;">物品清单:</view>
        <view class="flex-box-start">
          <text style="flex: 2; margin-right: 15rpx;">物品名称</text>
          <text style="flex: 1;">数量规格</text>
        </view>
        <view wx:for="{{ merchantMaterialInout.materialDetail }}" wx:key="unique" wx:for-item="material" class="flex-box-space">
          <view style="flex: 2; margin-right: 15rpx;">{{ material.name }}</view>
          <view style="flex: 1;">{{ material.quantity }}</view>
        </view>
      </view>
      <view wx:if="{{ merchantMaterialInout.remark }}" class="flex-box-space">
        <text>备注:</text>
        <text class="text">{{ merchantMaterialInout.remark }}</text>
      </view>
    </view>
    <view wx:if="{{ contractFileList.length > 0 }}" class="data-box" style="font-size: 26rpx; margin: 25rpx 0;">
      <view class="flex-box bold-font" style="font-size: 35rpx;">物品放行附件</view>
      <view wx:for="{{ contractFileList }}" wx:key="unique" wx:for-item="file" data-url="{{ file.file_url }}" data-name="{{ file.file_name }}" bind:tap="openFile">
