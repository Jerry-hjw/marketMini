<!--pages/login/index.wxml-->
<view class="main">
  <image src="/img/bgImg.jpg" class="bg-img"></image>
  <view class="container">
    <view class="data-box" style="background: rgba(255, 255, 255, 0.3); border-radius: 30rpx;">
      <image src="/img/login.png" style="width: 80%; margin: 0 auto;" mode="widthFix"/>
      <view class="flex-box-vertical">
        <view class="bold-font" style="font-size: 45rpx; line-height: 70rpx;">欢迎您来到</view>
        <view class="bold-font" style="font-size: 45rpx; line-height: 70rpx;">玖洲道运营管理系统</view>
      </view>
      <button open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber" style="padding: 0; margin: 30rpx; width: auto;">
        <view class="primary-button" style="width: 100%; height: 80rpx; line-height: 80rpx; border-radius: 40rpx 40rpx 0 40rpx;">授权手机号登录</view>
      </button>
    </view>
  </view>
</view>
