/* components/menu/index.wxss */
.menu {
  position: fixed;
  bottom: 20rpx;
  left: 50%;
  transform: translate(-50%, 0);
  width: 75%;
  height: 120rpx;
  display: flex;
  align-items: center;
  margin: 0 auto;
}
.menu-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: bold;
  color: #999;
}
.menu-img {
  width: 55rpx;
  height: 55rpx;
  margin-bottom: 5rpx;
}
.big-img {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-bottom: 15rpx;
  margin-top: -48rpx;
  box-sizing: border-box;
  background-color: #fff;
}
.bigger-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin-bottom: 7rpx;
  margin-top: -60rpx;
  box-sizing: border-box;
  background-color: #fff;
}
.active {
  color: #8ec31f;
}
/* 扇形区 */
.turn-container {
  position: absolute;
  left: 50%;
  transform: translate(-50%, 0);
  z-index: -99;
  width: 440rpx;
  height: 220rpx;
  border-radius: 220rpx 220rpx 0 0;
  background-color: #fff;
  box-shadow: 0 0 10rpx #dadada;
  transform-origin: bottom center;
  /* transform: rotate(0deg); */
  transition: 1s;
  font-size: 23rpx;
  /* overflow: hidden; */
}
.prise-container-1 {
  width: 100rpx;
  height: 220rpx;
  position: absolute;
  left: 50%;
  top: 25rpx;
  transform: translate(-50%, 0);
  transform-origin: 0% 100%;
  transform: rotate(-60deg);
  transition: 1s;
  /* transform: rotate(0deg) skewY(-45deg); */
  z-index: -1;
}
