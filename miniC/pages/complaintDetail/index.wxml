<!--pages/complaint/index.wxml-->
<view class="main">
  <navbar top="{{ top }}" title="投诉建议"></navbar>
  <image src="/img/bgImg.png" class="bg-img"></image>
  <view class="container" style="margin-top: 25rpx;">
    <view style="width: 100%;">
      <!-- <view class="flex-box" style="position: relative; height: 130rpx; letter-spacing: 10rpx;">
        <image src="/img/linearGradient.png" style="width: 100%; height: 100%; z-index: -1;" class="absolute" />
        <text wx:if="{{ !pr_complaint_id }}" class="bold-font">待提交</text>
        <text wx:if="{{ complaint.handle_status === 'N' }}" class="bold-font" style=" color: #359eff;">待处理</text>
        <text wx:if="{{ complaint.handle_status === 'Y' }}" class="bold-font" style="color: #9ae533;">已处理</text>
      </view> -->
      <view style="padding: 35rpx 50rpx; font-size: 28rpx; background-color: #fff; border-radius: 30rpx;">
        <view class="flex-box-start" style="margin-bottom: 35rpx;">
          <text class="bold-font" style="width: 120rpx; text-align: center; margin-right: 20rpx; font-size: 28rpx;">商家品牌</text>
          <view style="width: calc(100% - 140rpx); position: relative;">
            <input value="{{ complaint.brand_name }}" placeholder="请输入品牌名称(不填写则指针对平台)" data-prop="brand_name" bindfocus="queryCustomer" bindblur="closeSelection" bindinput="setValue" style="width: 100%; height: 60rpx; padding: 0 10rpx; box-sizing: border-box; background-color: #eaeaea; border-radius: 10rpx;" placeholder-style="font-size: 24rpx;" />
            <view style="position: absolute; width: 100%; top: 70rpx; left: 0; height: {{ customerList.length > 0 ? 'auto' : '0' }}; font-size: 26rpx; padding: {{ customerList.length > 0 ? '10rpx' : '0' }}; box-sizing: border-box; z-index: 10; background-color: #9ae533; border-radius: 10rpx;">
              <view wx:for="{{ customerList }}" wx:key="unique" wx:for-item="customer" data-value="{{ customer.customer_name }}" data-id="{{ customer.pr_customer_id }}" bind:tap="chooseCustomer">{{ customer.customer_name }}</view>
            </view>
          </view>
        </view>
        <view class="flex-box-start" style="margin-bottom: 35rpx; align-items: flex-start;">
          <text class="bold-font" style="width: 120rpx; text-align: center; margin-right: 20rpx; font-size: 28rpx;">投诉建议</text>
          <textarea value="{{ complaint.complaint_content }}" placeholder="请输入内容(不少于10个字)" data-prop="complaint_content" bindinput="setValue" style="width: calc(100% - 140rpx); background-color: #eaeaea; border-radius: 10rpx; padding: 10rpx;" placeholder-style="font-size: 24rpx;" />
        </view>
        <view class="flex-box-start" style="align-items: flex-start; margin-bottom: 35rpx;">
          <text class="bold-font" style="width: 120rpx; text-align: center; margin-right: 20rpx; font-size: 28rpx;">上传图片</text>
          <view style="display: flex; flex-wrap: wrap; width: calc(100% - 140rpx);">
            <view wx:for="{{ imgList }}" wx:key="index" wx:for-item="upload" style="position: relative; width: 130rpx; height: 130rpx; margin: 0 20rpx 20rpx 0; border: 1rpx dotted #eaeaea;">
              <image wx:if="{{ upload.src && !pr_complaint_id }}" class="close-button" src="../../img/close1.png" data-index="{{ index }}" bindtap="deleteUploadFile"></image>
              <image src="{{ IMG_BASE_URL + upload.src }}" class="evaluate-img" bindtap="showBigImage" mode="aspectFill" data-url="{{ IMG_BASE_URL + upload.src }}"></image>
            </view>
            <view wx:if="{{ imgList.length < 5 && !pr_complaint_id }}" style="width: 130rpx; height: 130rpx; border: 4rpx dotted rgba(68, 144, 87, 0.2); line-height: 130rpx; text-align: center; color: rgba(68, 144, 87, 0.2); font-size: 80rpx;" bindtap="uploadFile">+</view>
          </view>
        </view>
        <view class="flex-box-start" style="margin-bottom: 35rpx;">
          <text class="bold-font" style="width: 120rpx; text-align: center; margin-right: 20rpx; font-size: 28rpx;">联系电话</text>
          <view style="width: calc(100% - 140rpx); position: relative;">
            <input value="{{ complaint.contacts_phone }}" placeholder="请输入联系电话" data-prop="contacts_phone" bindinput="setValue" style="width: 100%; height: 60rpx; padding: 0 10rpx; box-sizing: border-box; background-color: #eaeaea; border-radius: 10rpx;" placeholder-style="font-size: 24rpx;" />
          </view>
        </view>
        <view wx:if="{{ complaint.complaint_date }}" class="flex-box-start" style="margin-bottom: 35rpx;">
          <text class="bold-font" style="width: 120rpx; text-align: center; margin-right: 20rpx; font-size: 28rpx;">提交时间</text>
          <text style="color: #999;">{{ complaint.complaint_date }}</text>
        </view>
        <view wx:if="{{ complaint.handle_date }}" class="flex-box-start" style="margin-bottom: 35rpx;">
          <text class="bold-font" style="width: 120rpx; text-align: center; margin-right: 20rpx; font-size: 28rpx;">处理时间</text>
          <view style="width: calc(100% - 140rpx); color: #999; word-break: break-all;">{{ complaint.handle_date }}</view>
        </view>
        <view wx:if="{{ complaint.handle_remark }}" class="flex-box-start">
          <text class="bold-font" style="width: 120rpx; text-align: center; margin-right: 20rpx; font-size: 28rpx;">处理意见</text>
          <view style="width: calc(100% - 140rpx); color: #999; word-break: break-all;">{{ complaint.handle_remark }}</view>
        </view>
      </view>
    </view>
  </view>
  <view style="text-align: center;" class="label-font">温馨提示: 此投诉为本小程序自有投诉渠道，非微信官方投诉渠道</view>
</view>

<view wx:if="{{ !pr_complaint_id }}" class="fixed" style="width: 96%; padding-bottom: 30rpx;">
  <view class="flex-box" style="padding: 25rpx; background: linear-gradient(to bottom, #cafc85, #9ae533); border-radius: 50rpx; box-sizing: border-box;" bind:tap="save">
    <text class="bold-font">确 认 提 交</text>
  </view>
</view>
