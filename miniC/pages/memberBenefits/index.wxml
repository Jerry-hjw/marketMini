<!--pages/memberBenefits/index.wxml-->
<view class="main">
  <navbar top="{{ top }}" title="会员权益"></navbar>
  <image src="/img/bgImg.png" class="bg-img"></image>
  <view class="container" style="margin-top: 25rpx;">
    <view style="position: relative; height: 350rpx; padding: 60rpx 50rpx;">
      <image wx:if="{{ activeLevel === '01' }}" src="{{ IMG_BASE_URL + '/member/01.jpg' }}" style="width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: -1;" />
      <image wx:if="{{ activeLevel === '02' }}" src="{{ IMG_BASE_URL + '/member/02.jpg' }}" style="width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: -1;" />
      <image wx:if="{{ activeLevel === '03' }}" src="{{ IMG_BASE_URL + '/member/03.jpg' }}" style="width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: -1;" />
      <!-- <view class="bold-font" style="margin-top: 40rpx;">{{ memberLevel[member_level] }}</view> -->
      <view style="position: absolute; left: 60rpx; bottom: 30rpx; font-size: 28rpx; font-weight: bold;">卡号: {{ member_no }}</view>
    </view>
    <view class="flex-box">
      <view wx:for="{{ levelList }}" wx:key="unique" class="level {{ item.id === activeLevel ? 'active' : '' }}" data-id="{{ item.id }}" bind:tap="changeLevel">{{ item.name }}</view>
    </view>
    <view style="margin-top: 25rpx;">
      <image wx:if="{{ activeLevel === '01' }}" src="{{ IMG_BASE_URL + '/member/011.jpg' }}" style="width: 100%;" mode="widthFix"/>
      <image wx:if="{{ activeLevel === '02' }}" src="{{ IMG_BASE_URL + '/member/022.jpg' }}" style="width: 100%;" mode="widthFix"/>
      <image wx:if="{{ activeLevel === '03' }}" src="{{ IMG_BASE_URL + '/member/033.jpg' }}" style="width: 100%;" mode="widthFix"/>
    </view>
  </view>
</view>