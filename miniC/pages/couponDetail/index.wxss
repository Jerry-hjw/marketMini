/* pages/couponDetail/index.wxss */
.content {
  margin: 20rpx 0;
  padding-bottom: 20rpx;
  box-sizing: border-box;
  border-radius: 5rpx 80rpx 5rpx 5rpx;
  background-color: #fff;
  box-shadow: 0 0 10rpx #dddddd;
}
.content>view {
  width: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.icon {
  width: 25rpx;
  height: 25rpx;
  margin-right: 10rpx;
  margin-top: 3rpx;
}
.float-text {
  font-size: 22rpx;
  color: #aaa;
}
.title {
  font-size: 28rpx;
  font-weight: bold;
}
.plus-button {
  width: 35rpx;
  height: 35rpx;
  line-height: 31rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(243, 190, 183, 0.2);
  color: #ea2e15;
  margin-left: 15rpx;
}
.reduce-button {
  width: 35rpx;
  height: 35rpx;
  line-height: 31rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(243, 190, 183, 0.2);
  color: #666;
  margin-right: 15rpx;
}
.disable-button {
  width: 35rpx;
  height: 35rpx;
  line-height: 31rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(211, 211, 211, 0.4);
  color: #999;
  margin-right: 15rpx;
}
.quantity-num {
  font-size: 24rpx;
}