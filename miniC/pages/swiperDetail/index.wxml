<!--pages/swiperDetail/index.wxml-->
<view class="main">
  <navbar top="{{ top }}" title="详情介绍"></navbar>
  <image src="/img/bgImg.png" class="bg-img"></image>
  <view class="container" style="padding: 20rpx 0;">
    <image src="{{ IMG_BASE_URL + swiper.swiper_img_url }}" style="width: 100%;" mode="widthFix"/>
    <view class="bold-font" style="margin: 30rpx auto; font-size: 40rpx; text-align: center;">{{ swiper.swiper_title }}</view>
    <rich-text nodes="{{ swiper.swiper_content }}"/>
  </view>
</view>