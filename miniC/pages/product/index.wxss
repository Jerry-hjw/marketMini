/* pages/product/index.wxss */
.search-icon {
  position: absolute;
  left: 23rpx;
  top: 23rpx;
  width: 35rpx;
  height: 35rpx;
}
.input-view {
  width: 100%;
  height: 80rpx;
  padding-left: 70rpx;
  padding-right: 30rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  background-color: #fff;
  color: #333;
  border-radius: 50rpx;
}
.flex-wrap-item {
  width: 48%;
  box-shadow: 0 0 10rpx #eaeaea;
}
.flex-wrap-item:nth-child(2n + 1) {
  margin-right: 4%;
}