<!--pages/index/index.wxml-->
<view class="main">
  <navbar top="{{ top }}" isIndex="true"></navbar>
  <image src="/img/bgImg.png" class="bg-img"></image>
  <view class="container" style="padding-bottom: 130rpx;">
    <view class="flex-box-space">
      <view class="flex-box-start">
        <image src="{{ member.avatarUrl || member.avatarUrl === 'undefined' ? '/img/avatarUrl.png' : member.avatarUrl }}" style="width: 90rpx; height: 90rpx; margin: 0 20rpx; border-radius: 10rpx;"  data-url="/pages/userDetail/index" bind:tap="toPage"></image>
        <view style="width: calc(100% - 220rpx);">
          <view class="flex-box-start" style="margin-bottom: 10rpx; font-size: 28rpx;" data-url="/pages/userDetail/index" bind:tap="toPage">
            <text wx:if="{{ member.member_type !== 'wechat' }}">{{ member.full_name || '' }}</text>
            <text wx:else>点击注册</text>
            <image src="/img/ic_right.png" style="width: 10rpx; height: 20rpx; margin-left: 15rpx;" />
          </view>
          <view wx:if="{{ member.member_type !== 'wechat' }}" class="flex-box-start">
            <view class="flex-box-start" style="font-size: 20rpx; color: #999;">
              <view class="flex-box-start" style="max-width: 130rpx;">
                <image src="/img/gold_small.png" style="width: 25rpx; height: 25rpx; margin-right: 5rpx;" />
                <text>会员积分 : </text>
              </view>
              <view>{{ member.integral_balance || 0 }}</view>
            </view>
            <view class="flex-box-start" style="font-size: 20rpx; color: #999;" data-url="/pages/userCoupon/index" bind:tap="toPage">
              <view class="flex-box-start" style="max-width: 90rpx;">
                <image src="/img/coupon_small.png" style="width: 25rpx; height: 25rpx; margin-right: 5rpx;" />
                <text>卡券 : </text>
              </view>
              <view>{{ member.coupon_amount || 0 }}</view>
            </view>
          </view>
          <view wx:else style="font-size: 20rpx; letter-spacing: 3rpx;">注册成为玖洲道会员，尊享多重礼遇！</view>
        </view>
      </view>
      <image src="/img/scanCode.png" style="width: 55rpx; height: 50rpx; margin-right: 20rpx;" />
    </view>
    <!-- 轮播图 -->
    <swiper indicator-dots="{{ bannerList && bannerList.length > 1 }}" indicator-active-color="#9ae533" autoplay indicator-color="#aaa" vertical="{{ false }}" style="height: 400rpx; margin: 25rpx 0; border-radius: 50rpx;">
      <block wx:for="{{ bannerList }}" wx:key="index">
        <swiper-item>
          <image src="{{ item.swiper_img_url ? IMG_BASE_URL + item.swiper_img_url : item.url }}" style="width: 100%; height: 100%; border-radius: 50rpx;" data-id="{{ item.pr_swiper_id }}" data-url="{{ item.click_handle_url }}" data-content="{{ item.swiper_content }}" bindtap="swiperClick"></image>
        </swiper-item>
      </block>
    </swiper>
    <!-- 功能菜单 -->
    <view class="flex-box-space" style="margin: 25rpx 0; padding: 0 10rpx; box-sizing: border-box;">
      <view wx:for="{{ functionList }}" wx:key="unique" wx:for-item="func" class="flex-box-vertical" style="width: auto;" data-url="{{ func.url }}" bindtap="toPage">
        <image src="{{ func.img }}" style="width: 85rpx; height: 85rpx; margin-bottom: 5rpx;"></image>
        <text class="label">{{ func.name }}</text>
      </view>
    </view>
    <!-- 横向滚动菜单 -->
    <view style="display: flex; width: calc(100% - 40rpx); overflow: auto; margin: 0 auto; padding-bottom: 25rpx; clip-path: inset(0 0 10px);">
      <view wx:for="{{ functionList2 }}" wx:key="index" wx:for-item="func2" style="display: flex; align-items: center; white-space: nowrap; text-align: center; padding: 8rpx 0; box-sizing: border-box;color: {{ index === funcIndex ? '#333' : '#999' }}; position: relative;" data-index="{{ index }}" bindtap="setFuncIndex">
        <text class="func-text">{{ func2 }}</text>
        <view wx:if="{{ index < functionList2.length - 1 }}" style="width: 1rpx; height: 28rpx; margin-top: 2rpx; background-color: #999;"></view>
        <image wx:if="{{ index === funcIndex }}" src="/img/menuActive.png" style="width: {{ index === 2 ? '190rpx' : '150rpx' }}; height: 5rpx; position: absolute; bottom: 0rpx; left: 50%; transform: translate(-50%, 0); z-index: -1;"></image>
      </view>
    </view>
    <view wx:if="{{ funcIndex === 0 }}" style="padding: 0 10rpx; box-sizing: border-box;">
      <view wx:for="{{ dataList }}" wx:key="unique" wx:for-item="brand" style="padding-bottom: 20rpx; margin-bottom: 20rpx; border-radius: 30rpx; background-color: #fff; box-shadow: 0 0 8rpx #afadad;" data-id="{{ brand.pr_brand_guide_id }}" data-type="brand" bind:tap="toDetail">
        <view style="width: 100%; padding: 20rpx 35rpx; box-sizing: border-box; border-bottom: 1rpx solid #9ae533; margin-bottom: 1rpx;">
          <view class="bold-font nowrap" style="font-size: 28rpx; margin-bottom: 10rpx;">{{ brand.shop_name }}</view>
          <view class="flex-box-space">
            <text style="font-size: 22rpx; color: #999;">{{ brand.address }}</text>
            <!-- <image src="{{ brand.isCollect ? '/img/isCollect.png' : '/img/outCollect.png' }}" style="width: 30rpx; height: 30rpx;" /> -->
          </view>
        </view>
        <image src="{{ brand.header_img_url ? IMG_BASE_URL + brand.header_img_url : '' }}" style="width: 100%; height: 350rpx;" mode="aspectFill"/>
      </view>
    </view>
    <view wx:if="{{ funcIndex === 1 }}" style="padding: 0 10rpx; box-sizing: border-box;">
      <view wx:for="{{ dataList }}" wx:key="unique" wx:for-item="data" style="padding: 20rpx; box-sizing: border-box; margin-bottom: 20rpx; border-radius: 30rpx; background-color: #fff; box-shadow: 0 0 8rpx #afadad;" class="flex-box-space" data-type="product" data-id="{{ data.pr_product_id }}" bind:tap="toDetail">
        <image src="{{ IMG_BASE_URL + data.product_pic_1 }}" style="width: 200rpx; height: 200rpx; border-radius: 30rpx;" mode="aspectFill"/>
        <view class="flex-box-vertical" style="width: calc(100% - 220rpx); height: 200rpx; justify-content: space-between; align-items: flex-start;">
          <view style="width: 100%;">
            <view class="bold-font nowrap">{{ data.product_name }}</view>
            <view class="flex-box-space" style="margin: 15rpx 0;">
              <!-- <progress percent="10" border-radius="15" active active-color="#9ae533" backgroundColor="#9be5332d" stroke-width="15" style="width: 300rpx;" /> -->
              <text style="font-size: 22rpx; color: #999;">剩余: {{ data.inventory_quantity }}</text>
            </view>
            <view wx:if="{{ data.reverseTime }}" class="label-font">倒计时: <text wx:if="{{ data.day }}">{{ data.day }}天</text><text wx:if="{{ data.hour }}"> {{ data.hour }}时</text><text> {{ data.minute }}分</text><text> {{ data.second }}秒</text></view>
          </view>
          <view class="flex-box-space">
            <view class="price-font">
              <text wx:if="{{ data.exchange_price > 0 }}">{{ data.exchange_price }}<text style="font-size: 26rpx;">元</text></text>
              <text wx:else>{{ data.exchange_integral }}<text style="font-size: 26rpx;">积分</text></text>
            </view>
            <view style="padding: 5rpx 25rpx; background: #9ae533; color: #fff; font-size: 22rpx; border-radius: 5rpx;">秒 杀</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{ funcIndex === 2 }}" style="padding: 0 10rpx; box-sizing: border-box;">
      <view wx:for="{{ dataList }}" wx:key="unique" wx:for-item="party" style="padding-bottom: 20rpx; margin-bottom: 20rpx; border-radius: 30rpx; background-color: #fff; box-shadow: 0 0 8rpx #afadad;" data-id="{{ party.pr_mall_party_id }}" data-type="mallParty" bind:tap="toDetail">
        <image src="{{ party.party_img_url ? IMG_BASE_URL + party.party_img_url : '' }}" style="width: 100%; height: 350rpx; border-radius: 30rpx 30rpx 0 0;" mode="aspectFill"/>
        <view class="flex-box-space" style="padding: 10rpx 25rpx; font-size: 24rpx; color: #999; box-sizing: border-box;">
          <text wx:if="{{ party.number_limit }}">限{{ party.number_limit }}人报名参与</text>
          <text wx:else>参与人数不限制</text>
          <text style="color: #9ae533;">活动报名 ></text>
        </view>
      </view>
    </view>
    <!-- <view class="fan-container">
      <view class="fan fan-1"></view>
      <view class="fan fan-2"></view>
      <view class="fan fan-3"></view>
      <view class="fan fan-4"></view>
      <view class="fan fan-5"></view>
      <view class="fan fan-6"></view>
      <view class="fan fan-7"></view>
      <view class="fan fan-8"></view>
    </view> -->
  </view>
</view>

<menu menuIndex="{{ 1 }}" memberType="{{ member.member_type }}" fullName="{{ member.full_name }}" prMemberId="{{ member.pr_member_id }}"></menu>
