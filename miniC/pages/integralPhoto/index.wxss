/* pages/integralPhoto/index.wxss */
.toast {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-height: 100vh;
  z-index: 19;
}
.toast-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 20;
}
.toast-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  /* background-color: #fff; */
  border-radius: 15rpx;
  padding: 30rpx;
  box-sizing: border-box;
  z-index: 21;
}