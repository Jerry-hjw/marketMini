<!--pages/brandGuide/index.wxml-->
<view class="main">
  <navbar top="{{ top }}" title="品牌导览"></navbar>
  <image src="/img/bgImg.png" class="bg-img"></image>
  <view class="container" style="padding: 20rpx 0;">
    <view style="position: relative; width: 100%;">
      <image src="/img/search.png" class="search-icon" bind:tap="getBrandList" />
      <input value="{{ keyword }}" type="text" class="input-view" placeholder="请输入关键字" placeholder-style="font-size: 28rpx;" bindinput="setValue" />
    </view>
    <view class="flex-box-start" style="margin: 25rpx 5rpx; position: relative;">
      <view style="width: 33.33%;" class="flex-box-start">
        <view style="position: relative;" data-index="{{ 1 }}" bind:tap="changeFilter">
          <text style="font-size: 30rpx; font-weight: bold;">{{ building_name || '楼层' }}</text>
          <image src="/img/arrow.png" style="width: 30rpx; height: 25rpx; margin-left: 10rpx; transform: rotate({{ filterIndex === 1 ? '180deg' : '0' }});" />
          <image wx:if="{{ filterIndex === 1 }}" src="/img/menuActive.png" style="width: 100rpx; height: 5rpx; position: absolute; bottom: -9rpx; left: 50%; transform: translate(-50%, 0); z-index: -1;"></image>
        </view>
      </view>
      <view style="width: 33.33%;" class="flex-box-start">
        <view style="position: relative;" data-index="{{ 2 }}" bind:tap="changeFilter">
          <text style="font-size: 30rpx; font-weight: bold;">{{ biz_type_name || '业态' }}</text>
          <image src="/img/arrow.png" style="width: 30rpx; height: 25rpx; margin-left: 10rpx; transform: rotate({{ filterIndex === 2 ? '180deg' : '0' }});" />
          <image wx:if="{{ filterIndex === 2 }}" src="/img/menuActive.png" style="width: 100rpx; height: 5rpx; position: absolute; bottom: -9rpx; left: 50%; transform: translate(-50%, 0); z-index: -1;"></image>
        </view>
      </view>
      <view style="position: absolute; top: 50rpx; left: -4%; z-index: 51; width: 100vw; max-height: {{ filterList.length > 0 ? '450rpx' : '0' }}; overflow: auto; transition: 0.3s; background-color: #f8f8f8;">
        <view wx:for="{{ filterList }}" wx:key="unique" wx:for-item="filter" class="filter-item" data-id="{{ filter.id }}" data-name="{{ filter.name }}" bind:tap="chooseFilter">
          <text>{{ filter.name }}</text>
          <image wx:if="{{ filter.id === pr_building_id || filter.id === pr_biz_type_id }}" src="/img/yes.png" style="width: 30rpx; height: 30rpx;" />
        </view>
      </view>
      <view wx:if="{{ filterList.length > 0 }}" style="position: absolute; top: 48rpx; left: -4%; z-index: 50; width: 100vw; height: calc(100vh - {{ top + 'rpx' }} - 35rpx - 100rpx - 50rpx); background-color: rgba(0, 0, 0, 0.3);" bind:tap="closeFilter"></view>
    </view>
    <view style="margin: 25rpx 0;">
      <view wx:for="{{ dataList }}" wx:key="unique" wx:for-item="brand" style="margin: 15rpx 0; background-color: #eaeaea; box-shadow: 0 0 8rpx #afadad; height: 190rpx;" class="flex-box-space" data-id="{{ brand.pr_brand_guide_id }}" bind:tap="toDetail">
        <image src="{{ brand.logo_img_url ? IMG_BASE_URL + brand.logo_img_url : '' }}" style="width: 190rpx; height: 100%; background-color: #fff;" mode="aspectFit"/>
        <view style="width: calc(100% - 195rpx); height: 100%; padding: 20rpx; box-sizing: border-box; font-size: 23rpx; color: #999; background-color: #fff; letter-spacing: 2rpx;">
          <view class="bold-font nowrap" style="font-size: 28rpx; margin-bottom: 15rpx;">{{ brand.shop_name }}</view>
          <view style="margin-bottom: 5rpx;">
            <text style="margin-right: 10rpx;">联系电话: </text>
            <text>{{ brand.contact_phone }}</text>
          </view>
          <view style="margin-bottom: 5rpx;">
            <text style="margin-right: 10rpx;">营业时间: </text>
            <text>{{ brand.working_time }}</text>
          </view>
          <view>
            <text style="margin-right: 10rpx;">地理位置: </text>
            <text>{{ brand.address }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>